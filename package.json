{
  "name": "projektijuhtimise-tooriist",
  "version": "0.1.0",
  "private": true,
  "description": "AI-põhine projektijuhtimise tööriist: kliendi ideest kasutajalugude backlog'iks (TAK25)",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.1"
  }
}
