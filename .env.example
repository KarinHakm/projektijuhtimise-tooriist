# Kopeeri see fail nimega .env (cp .env.example .env). .env faili ei lisata git'i.

# Serveri port
PORT=3001

# SQLite andmebaasi fail (kaust luuakse automaatselt)
DATABASE_PATH=./data/app.db

# AI-teenus (kasutusel alates loost L02). Tokeni väärtus pane ainult oma .env faili.
HETZNER_INFERENCE_TOKEN=
HETZNER_MODEL=Qwen3.8-27B
