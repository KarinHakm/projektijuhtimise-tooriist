# Kopeeri see fail nimega .env (cp .env.example .env). .env faili ei lisata git'i.

# Serveri port
PORT=3001

# SQLite andmebaasi fail (kaust luuakse automaatselt)
DATABASE_PATH=./data/app.db

# AI-teenus. Vaikimisi Claude Code CLI: serveri arvutis sisse logitud kasutaja tellimus (käsk „claude“),
# API-võtit ei ole vaja ega kasutata. Võimalikud väärtused: claude-cli, off.
AI_PROVIDER=claude-cli
CLAUDE_MODEL=sonnet
# Kui käsk „claude“ ei ole PATH-is, kirjuta siia täielik tee (Windowsis nt ...\claude.exe).
CLAUDE_COMMAND=claude

# Ühe AI-ülesande ajalimiit millisekundites (koos võimaliku korduspäringuga)
AI_TIMEOUT_MS=150000
